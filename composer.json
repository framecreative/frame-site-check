{
    "name": "framecreative/frame-site-check",
    "description": "Containerised smoke testing for Frame Laravel/Statamic sites, against generated test data.",
    "type": "composer-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "composer-plugin-api": "^2.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/process": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "suggest": {
        "statamic/cms": "Enables the Statamic content and control panel account seeding"
    },
    "autoload": {
        "psr-4": {
            "Frame\\SiteCheck\\": "src/"
        }
    },
    "bin": [
        "bin/site-check"
    ],
    "extra": {
        "class": "Frame\\SiteCheck\\Composer\\SkillLinker"
    }
}
